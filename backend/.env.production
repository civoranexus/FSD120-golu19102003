# Netlify Environment Variables
# Copy these to your Netlify site settings

# Frontend URL
FRONTEND_URL=https://your-netlify-site-url.netlify.app

# Environment
NODE_ENV=production

# MongoDB Atlas Configuration (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/society360?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASS=your_production_email_password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=/tmp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_production_session_secret_key_here

# Logging
LOG_LEVEL=info

# External APIs
PAYMENT_GATEWAY_KEY=your_production_payment_gateway_key
SMS_API_KEY=your_production_sms_api_key
